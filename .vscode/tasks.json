{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TTX Flow Tests Build (Linux) [Debug]",
      "type": "process",
      "command": "bazel",
      "args": [
        "build",
        "//validation/unit_tests/ttx/semantic:flow_tests",
        "--config=debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "Builds the focused TTX Flow tests and both C providers for debugging.",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "Puffer SDK Build (Linux) [Debug]",
      "type": "shell",
      "command": "${workspaceFolder}/puffer/package.sh",
      "args": [
        "--debug"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "clear": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Validation Unit Tests Build (Linux) [Debug]",
      "type": "shell",
      "command": "bazel",
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "build",
        "//validation:unit_tests",
        "--config=debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Builds the complete validation unit-test binary.",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "Validation Unit Tests Build (Linux) [Release]",
      "type": "shell",
      "command": "bazel",
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "build",
        "//validation:unit_tests",
        "--config=release"
      ],
      "group": "build",
      "detail": "Builds the release validation unit-test binary.",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "Validation Benchmarks Build (Linux) [Release]",
      "type": "shell",
      "command": "bazel",
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "build",
        "//validation:benchmarks",
        "--config=release"
      ],
      "group": "build",
      "detail": "Builds the release validation benchmark binary.",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "TTX LLVM Debug Validation Build (Linux)",
      "type": "shell",
      "command": "bazel",
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "build",
        "//validation:unit_tests",
        "--config=debug",
      ],
      "group": "build",
      "detail": "Builds the validation binary with full DWARF for its TTX runtime integration.",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "TTX Echo Build (Linux) [Debug]",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "type": "process",
      "command": "${workspaceFolder}/.bin/puffer-sdk/bin/puffer",
      "dependsOn": [
        "Puffer SDK Build (Linux) [Debug]"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "${workspaceFolder}/apps/ttx/echo/build.ttx"
      ],
      "group": "build",
      "detail": "Builds the pure TTX Echo application with full source debug information.",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "TTX Scene Lifetime Build (Linux) [Debug]",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "type": "process",
      "command": "${workspaceFolder}/.bin/puffer-sdk/bin/puffer",
      "dependsOn": [
        "Puffer SDK Build (Linux) [Debug]"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "${workspaceFolder}/apps/ttx/scene_lifetime/build.ttx"
      ],
      "group": "build",
      "detail": "Builds the TTX Scene Lifetime application with full source debug information.",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "TTX Lsp Build",
      "type": "shell",
      "command": "${workspaceFolder}/extension/package.sh",
      "args": [
        "--sync"
      ],
      "group": "build",
      "detail": "Builds Puffer, synchronizes the packaged server, and compiles the extension.",
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
