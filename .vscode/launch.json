    {
      "name": "[Lsp] Launch TTX client",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/extension/"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/out/**/*.js"
      ],
      "autoAttachChildProcesses": true,
      "preLaunchTask": "TTX Lsp Build",
    },
  ]
